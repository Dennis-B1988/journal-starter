# Copy this file to .env (which is git-ignored) and adjust as needed.
# This will ensure that you do not commit sensitive information to version control.
# This URL points to the local PostgreSQL container started via docker-compose.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_journal

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/career_journal
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/career_journal_test

# OPENAI compatible llm credentials:
# OPENAI_API_KEY=placeholder
# OPENAI_BASE_URL=https://example.invalid/v1
# OPENAI_MODEL=placeholder

# Amazon Bedrock with IAM credentials instead of an API key:
OPENAI_API_KEY=iam
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_MODEL=openai.gpt-oss-120b
AWS_REGION=us-east-1
# Credentials are read from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN, ~/.aws/credentials, SSO, or an attached IAM role.

BEDROCK_GUARDRAIL_IDENTIFIER=<identifier-id>
BEDROCK_GUARDRAIL_VERSION=1
# Optional:
BEDROCK_GUARDRAIL_TAG_SUFFIX=<your-guardrail-tag>

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=journal-api